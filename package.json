{
  "name": "work",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "version": "0.1.0",
  "bin": {
    "work": "src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/work",
    "e2e": "bun run build && test/e2e/run.sh",
    "install-local": "bun run build && install -m 755 dist/work \"${WORK_BIN_DIR:-$HOME/.local/bin}/work\""
  }
}
